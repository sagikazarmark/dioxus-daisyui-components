# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Rust
target/

# Node
node_modules/

# The generated Tailwind CSS (assets/style.css) is deliberately not listed in
# any .gitignore, which Dagger applies when it builds the Preview: `npm run
# build` adds it to the clone's .git/info/exclude instead. See
# scripts/exclude-generated.mjs.

# Playwright's output. The screenshot baselines are rendered from the base
# commit at the start of every run rather than stored, so they are output too.
tests/browser/screenshots/
tests/browser/test-results/
tests/browser/playwright-report/

.env
