      "rev": "86a28ea6bdc07683ea16f145f131fb7784457a27"
    },
    {
      "name": "input",
      "git": "https://github.com/sagikazarmark/dioxus-daisyui-components.git",
      "rev": "86a28ea6bdc07683ea16f145f131fb7784457a27"
    },
    {
      "name": "native_select",
      "git": "https://github.com/sagikazarmark/dioxus-daisyui-components.git",
      "rev": "86a28ea6bdc07683ea16f145f131fb7784457a27"
    },
    {
      "name": "button",
      "git": "https://github.com/sagikazarmark/dioxus-daisyui-components.git",
      "rev": "86a28ea6bdc07683ea16f145f131fb7784457a27"
    }
  ],
  "cargoDependencies": [
    {
      "name": "dioxus-field",
      "version": "0.8.0"
    },
    {
